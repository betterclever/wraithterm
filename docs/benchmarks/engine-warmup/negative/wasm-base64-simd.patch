+const vector_decode = builtin.cpu.arch.endian() == .little and
+    (std.simd.suggestVectorLength(u8) orelse 0) >= 16;
+
+/// Decode 16 standard-alphabet characters to 12 bytes at a time while both
+/// the input and a 16-byte store fit. Returns the input bytes consumed, a
+/// multiple of 16; output receives consumed / 4 * 3 decoded bytes (and up
+/// to four scratch bytes after them, which later output overwrites).
+fn decodeVectorBlocks(input: []const u8, output: []u8) usize {
+    const V = @Vector(16, u8);
+    const W = @Vector(4, u32);
+    const splat = struct {
+        inline fn u8s(v: u8) V {
+            return @splat(v);
+        }
+        inline fn u32s(v: u32) W {
+            return @splat(v);
+        }
+    };
+    var src: usize = 0;
+    var dst: usize = 0;
+    while (src + 16 <= input.len and dst + 16 <= output.len) {
+        const c: V = input[src..][0..16].*;
+        // Map each character to its 6-bit value; 0xFF marks a byte outside
+        // the alphabet ('=' included: padding was trimmed by the caller).
+        var v: V = splat.u8s(0xFF);
+        v = @select(u8, c -% splat.u8s('A') < splat.u8s(26), c -% splat.u8s('A'), v);
+        v = @select(u8, c -% splat.u8s('a') < splat.u8s(26), c -% splat.u8s('a' - 26), v);
+        v = @select(u8, c -% splat.u8s('0') < splat.u8s(10), c +% splat.u8s(52 - '0'), v);
+        v = @select(u8, c == splat.u8s('+'), splat.u8s(62), v);
+        v = @select(u8, c == splat.u8s('/'), splat.u8s(63), v);
+        if (@reduce(.Max, v) > 63) break;
+        // Each little-endian u32 lane holds one group a,b,c,d (a lowest);
+        // assemble its 24 bits, then emit them most significant byte first.
+        const x: W = @bitCast(v);
+        const m = splat.u32s(0xFF);
+        const bits = ((x & m) << splat.u32s(18)) |
+            (((x >> splat.u32s(8)) & m) << splat.u32s(12)) |
+            (((x >> splat.u32s(16)) & m) << splat.u32s(6)) |
+            (x >> splat.u32s(24));
+        const bytes: V = @bitCast(bits);
+        const out = @shuffle(u8, bytes, undefined, @Vector(16, i32){
+            2, 1, 0, 6, 5, 4, 10, 9, 8, 14, 13, 12, 3, 7, 11, 15,
+        });
+        output[dst..][0..16].* = out;
+        src += 16;
+        dst += 12;
+    }
+    return src;
+}
