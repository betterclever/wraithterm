+test "base64 vector blocks match the scalar decoder" {
+    if (comptime !vector_decode) return error.SkipZigTest;
+    const testing = std.testing;
+    var prng: std.Random.DefaultPrng = .init(0x5eed);
+    const random = prng.random();
+    const alphabet = std.base64.standard_alphabet_chars;
+    var source: [700]u8 = undefined;
+    var expected: [700]u8 = undefined;
+    var actual: [700]u8 = undefined;
+    for (0..2000) |round| {
+        const len = random.uintLessThan(usize, source.len);
+        for (source[0..len]) |*c| c.* = alphabet[random.uintLessThan(usize, 64)];
+        // Some rounds plant one byte outside the alphabet.
+        if (len > 0 and round % 3 == 0) source[random.uintLessThan(usize, len)] =
+            random.uintLessThan(u8, 255);
+        const input = scalarInput(source[0..len]);
+        const size = maxLenScalar(input);
+        const want = scalar_decoder.decode(expected[0..], input);
+        const got = decodeScalar(source[0..len], actual[0..]);
+        if (size == 0) continue;
+        if (want) |_| {
+            try testing.expectEqualSlices(u8, expected[0..size], try got);
+        } else |_| try testing.expectError(error.Base64Invalid, got);
+    }
+}
