+    // Four independent lanes avoid packing colors across 64-bit boundaries.
+    // Tags distinguish default, palette and RGB even when payloads are zero.
+    inline fn equalityWords(self: Style) @Vector(4, u32) {
+        return .{ colorWord(self.fg_color), colorWord(self.bg_color), colorWord(self.underline_color), @as(u16, @bitCast(self.flags)) };
+    }
+
+    inline fn colorWord(c: Color) u32 {
+        return switch (c) {
+            .none => 0,
+            .palette => |idx| @as(u32, idx) | (1 << 24),
+            .rgb => |rgb| @as(u32, @as(u24, @bitCast(rgb))) | (2 << 24),
+        };
+    }
