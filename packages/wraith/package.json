{
  "name": "wraithterm",
  "version": "0.5.0",
  "type": "module",
  "description": "xterm-compatible Terminal API and libghostty terminal core with Rust/Wasm/WebGPU rendering.",
  "license": "MIT",
  "homepage": "https://wraithterm.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/betterclever/wraithterm.git",
    "directory": "packages/wraith"
  },
  "bugs": {
    "url": "https://github.com/betterclever/wraithterm/issues"
  },
  "keywords": [
    "terminal",
    "xterm",
    "xterm.js",
    "ghostty",
    "libghostty",
    "webgpu",
    "wasm",
    "rust",
    "terminal-emulator",
    "react",
    "vue",
    "svelte",
    "web-component",
    "custom-element"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/element.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "require": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./xterm": {
      "types": "./dist/xterm.d.ts",
      "import": "./dist/xterm.js",
      "require": "./dist/xterm.js",
      "default": "./dist/xterm.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "default": "./dist/vue.js"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "import": "./dist/svelte.js",
      "default": "./dist/svelte.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js",
      "default": "./dist/element.js"
    },
    "./css/xterm.css": "./css/xterm.css"
  },
  "files": [
    "bin",
    "dist",
    "wasm",
    "licenses",
    "README.md",
    "LICENSE",
    "css",
    "docs/*.md",
    "docs/compatibility/*.json"
  ],
  "dependencies": {
    "@wraith-terminal/xterm-base": "npm:@xterm/xterm@6.0.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "svelte": ">=3",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./css/xterm.css",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "wraithterm": "bin/wraithterm.mjs"
  }
}
