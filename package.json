{
  "name": "wraith-workspace",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/wraith"
  ],
  "scripts": {
    "build:engine": "node scripts/build-engine.mjs",
    "build": "npm run build:engine && npm run build:sdk",
    "build:sdk": "node scripts/sync-xterm.mjs && tsc -p packages/wraith/tsconfig.json",
    "dev": "vite --host 127.0.0.1",
    "build:demo": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:browser": "node scripts/browser-test.mjs",
    "test:native": "node scripts/build-engine.mjs --native",
    "test:wasm": "node scripts/headless-test.mjs",
    "format": "prettier --write packages/wraith/src scripts demo docs README.md && cargo fmt --all",
    "optimize": "node scripts/optimize.mjs",
    "licenses": "node scripts/collect-licenses.mjs",
    "test:consumer": "node scripts/consumer-test.mjs",
    "test:xterm": "node scripts/xterm-browser-test.mjs",
    "test:experiments": "node scripts/test-experimental-input.mjs",
    "test:xterm-consumer": "node scripts/xterm-consumer-test.mjs",
    "benchmark:compare": "node scripts/compare-renderers.mjs",
    "benchmark:usage": "node scripts/measure-utilization.mjs",
    "benchmark:optimization": "node scripts/optimization-compare.mjs",
    "benchmark:retained": "node scripts/retained-rows-benchmark.mjs",
    "benchmark:experiments": "node scripts/performance-experiments.mjs",
    "pipes": "node scripts/pipes.mjs",
    "test:pipes": "node scripts/pipes-browser-test.mjs",
    "benchmark:pipes": "node scripts/pipes-benchmark.mjs",
    "test:retained": "node scripts/retained-rows-test.mjs",
    "deploy:site": "npm run build:sdk && npm run build:demo && wrangler deploy",
    "test:input": "node scripts/test-production-input.mjs",
    "test:native-interaction": "node scripts/native-interaction-test.mjs",
    "test:native-display": "node scripts/native-display-test.mjs",
    "test:native-kitty": "node scripts/native-kitty-test.mjs",
    "test:native-pool": "node scripts/native-pool-test.mjs",
    "test:serve": "node scripts/serve-test.mjs",
    "test:native-shaping": "node scripts/native-shaping-test.mjs",
    "benchmark:workflows": "node scripts/workflow-benchmark.mjs",
    "test:visual-options": "node scripts/gpu-visual-options-test.mjs",
    "benchmark:visual-options": "node scripts/visual-options-benchmark.mjs",
    "benchmark:search": "node scripts/search-benchmark.mjs",
    "test:native-search": "node scripts/native-search-test.mjs",
    "benchmark:bulk-text": "node scripts/bulk-text-benchmark.mjs",
    "profile:bulk-text": "node scripts/profile-bulk-text.mjs",
    "test:native-visibility": "node scripts/native-visibility-test.mjs",
    "benchmark:visibility": "node scripts/visibility-benchmark.mjs",
    "test:commands": "node scripts/command-blocks-test.mjs",
    "test:shell-integration": "node scripts/shell-integration-test.mjs",
    "benchmark:commands": "node scripts/command-blocks-benchmark.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@webgpu/types": "^0.1.64",
    "@wterm/core": "^0.5.5",
    "@wterm/dom": "^0.5.5",
    "@wterm/ghostty": "^0.5.5",
    "@xterm/addon-attach": "^0.12.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "^1.1.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^5.0.3"
  }
}
