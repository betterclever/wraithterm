+/// Optional host-managed cache of canonical forward text and byte-to-cell maps.
+/// The host MUST clear before writes, reset, reflow or any other content change.
+/// Keys are inspected only for live nodes passed by the current page list; old
+/// cached pointers are never dereferenced. Windows own copies of cached data.
+/// Bound retained payload to 32 MiB, independent of configured scrollback size.
+pub const PageCache = struct {
+    const Key = struct { node: *PageList.List.Node, serial: u64 };
+    const Entry = struct {
+        bytes: []u8,
+        points: []point.Coordinate,
+        rows: size.CellCountInt,
+        cols: size.CellCountInt,
+    };
+    enabled: bool = false,
+    dirty: bool = true,
+    entries: std.AutoHashMapUnmanaged(Key, Entry) = .empty,
+    bytes: usize = 0,
+    const limit = 32 * 1024 * 1024;
+
+    pub fn clear(self: *PageCache, alloc: Allocator) void {
+        var it = self.entries.valueIterator();
+        while (it.next()) |entry| {
+            alloc.free(entry.bytes);
+            alloc.free(entry.points);
+        }
+        self.entries.clearRetainingCapacity();
+        self.bytes = 0;
+        self.dirty = true;
+    }
+
+    pub fn deinit(self: *PageCache, alloc: Allocator) void {
+        self.clear(alloc);
+        self.entries.deinit(alloc);
+    }
+
+    fn get(self: *PageCache, node: *PageList.List.Node, page: *const terminal.Page) ?Entry {
+        if (!self.enabled) return null;
+        const entry = self.entries.get(.{ .node = node, .serial = node.serial }) orelse return null;
+        if (entry.rows != page.size.rows or entry.cols != page.size.cols) return null;
+        return entry;
+    }
+
+    fn put(self: *PageCache, alloc: Allocator, node: *PageList.List.Node, page: *const terminal.Page, bytes: []const u8, points: []const point.Coordinate) Allocator.Error!void {
+        if (!self.enabled) return;
+        const size_bytes = bytes.len + points.len * @sizeOf(point.Coordinate);
+        if (size_bytes > limit) return;
+        if (self.bytes + size_bytes > limit or self.entries.count() >= 2048) self.clear(alloc);
+        const entry: Entry = .{
+            .bytes = try alloc.dupe(u8, bytes),
+            .points = undefined,
+            .rows = page.size.rows,
+            .cols = page.size.cols,
+        };
+        var owned = entry;
+        errdefer alloc.free(owned.bytes);
+        owned.points = try alloc.dupe(point.Coordinate, points);
+        errdefer alloc.free(owned.points);
+        const previous = try self.entries.fetchPut(alloc, .{ .node = node, .serial = node.serial }, owned);
+        if (previous) |old| {
+            self.bytes -= old.value.bytes.len + old.value.points.len * @sizeOf(point.Coordinate);
+            alloc.free(old.value.bytes);
+            alloc.free(old.value.points);
+        }
+        self.bytes += size_bytes;
+    }
+};
