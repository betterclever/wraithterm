uniform float3 iResolution;
uniform float uClock;
uniform float uKind;
uniform float3 uCamera;
uniform float2 uOffset;
float box(float3 p, float3 b, float r) {
    float3 q = abs(p) - b;
    return length(max(q, 0.0)) + min(max(q.x, max(q.y, q.z)), 0.0) - r;
}
float2 turn(float2 p, float a) { return float2(cos(a)*p.x - sin(a)*p.y, sin(a)*p.x + cos(a)*p.y); }
float field(float3 p) {
    if (uKind < 0.5) {
        p.xy = turn(p.xy, -0.035 * sin(uClock * 0.4));
        p.x -= 0.43 * p.y;
        float a = box(p - float3(-0.38,0,0), float3(0.13,1.08,0.24), 0.075);
        float b = box(p - float3(0.38,0,0), float3(0.13,1.08,0.24), 0.075);
        return min(a,b) * 0.79;
    }
    if (uKind < 1.5) {
        p.xz = turn(p.xz, 0.24);
        p.y += 0.25 * sin(p.x * 1.1 + uClock * 0.2);
        float d = 100.0;
        for (int i=0; i<3; i++) {
            float3 q = p - float3(0,0,float(i)*0.16-0.16);
            float2 ring = float2(length(q.xy * float2(0.69,1.0))-1.02,q.z);
            d = min(d, length(ring)-0.055);
        }
        return d * 0.7;
    }
    float d = 100.0;
    p.xy = turn(p.xy,-0.12);
    for (int i=0; i<5; i++) {
        float k=float(i);
        float3 q = p-float3(k*0.045,k*0.06,k*0.17-0.34);
        d=min(d,box(q,float3(0.98,1.17,0.045),0.13));
    }
    return d;
}
float3 normalAt(float3 p) {
    float e = 0.002;
    return normalize(float3(field(p+float3(e,0,0))-field(p-float3(e,0,0)),
        field(p+float3(0,e,0))-field(p-float3(0,e,0)),
        field(p+float3(0,0,e))-field(p-float3(0,0,e))));
}
float3 studio(float3 r) {
    float strip=pow(max(0.0,1.0-abs(r.x+0.42)*2.1),12.0)*smoothstep(-0.2,0.4,r.y);
    float warm=pow(max(0.0,dot(r,normalize(float3(-0.8,0.7,0.3)))),32.0);
    float white=pow(max(0.0,dot(r,normalize(float3(0.8,0.6,0.1)))),80.0);
    float rim=pow(max(0.0,dot(r,normalize(float3(0.3,-0.1,-1)))),16.0);
    return float3(1.0,0.55,0.22)*strip*1.8 + float3(1.0,0.34,0.1)*warm*1.7
        + float3(1.0,0.89,0.77)*white*2.8 + float3(0.50,0.32,0.65)*rim*0.7;
}
half4 main(float2 coord) {
    float2 uv=(coord-0.5*iResolution.xy)/iResolution.y;
    uv-=uOffset;
    float az=uCamera.x, el=uCamera.y;
    float3 ro=float3(sin(az)*cos(el),sin(el),cos(az)*cos(el))*uCamera.z;
    float3 forward=normalize(-ro), right=normalize(cross(forward,float3(0,1,0))), up=cross(right,forward);
    float3 rd=normalize(forward*1.75+right*uv.x+up*(-uv.y));
    float distance=0.0;
    bool hit=false;
    for(int i=0;i<100;i++) {
        float d=field(ro+rd*distance);
        if(d<0.0012) { hit=true; break; }
        distance+=max(d,0.001);
        if(distance>14.0) break;
    }
    float3 col=float3(0.004,0.003,0.003);
    if(hit) {
        float3 p=ro+rd*distance, n=normalAt(p), ref=reflect(rd,n);
        float fresnel=pow(1.0-max(0.0,dot(n,-rd)),3.0);
        float diffuse=max(0.0,dot(n,normalize(float3(-0.4,0.8,1.5))));
        float ao=clamp(field(p+n*0.12)/0.12,0.2,1.0);
        col=(float3(0.105,0.034,0.016)*(0.4+diffuse*1.5)+studio(ref)*(0.55+fresnel*0.65))*ao;
        float3 key=normalize(float3(-1.8+sin(uClock*0.31)*1.6,2.5,3.7)-p);
        float gloss=pow(max(0.0,dot(n,normalize(key-rd))),46.0);
        float broad=pow(max(0.0,dot(n,normalize(key-rd))),7.0);
        col+=float3(1.0,0.68,0.37)*gloss*0.7+float3(0.23,0.095,0.042)*broad;
        col+=float3(0.35,0.12,0.045)*fresnel*0.22;
        if(uKind>1.5) {
            float2 mark=turn(p.xy,-0.12)-float2(0.18,0.24);
            mark.x-=0.43*mark.y;
            float emblem=min(abs(mark.x-0.24),abs(mark.x+0.24));
            float mask=(1.0-smoothstep(0.064,0.075,emblem))*(1.0-smoothstep(0.60,0.62,abs(mark.y)));
            float face=smoothstep(0.55,0.95,n.z);
            col=mix(col,float3(0.72,0.37,0.13)*(0.5+gloss),mask*face);
            float rows=1.0-smoothstep(0.003,0.008,abs(fract((p.y+1.0)*13.0)-0.5));
            col+=float3(0.06,0.022,0.008)*rows*face*(1.0-mask);
        }
        col=col/(0.7+col);
    } else {
        col+=float3(0.018,0.008,0.004)*exp(-2.5*length(uv-float2(0.35,-0.2)));
    }
    return half4(half3(col),1.0);
}
