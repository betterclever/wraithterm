{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["@webgpu/types", "node"]
  },
  "include": ["packages/wraith/src/**/*.ts", "demo/**/*.ts", "vite.config.ts"]
}
